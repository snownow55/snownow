{
  "name": "snow-condition-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:missing": "playwright test --config playwright.missing.config.ts",
    "typecheck": "tsc --noEmit",
    "collect:official": "node scripts/collect-official-conditions.ts",
    "test:db": "python3 supabase/tests/run-isolated.py",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "predeploy:vinext": "node scripts/check-cloudflare-development.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "geist": "^1.7.2",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@vercel/analytics": "2.0.1",
    "vinext": "1.4.6",
    "react-server-dom-webpack": "19.3.1",
    "@vinext/cloudflare": "1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "8.3.8",
    "@vitejs/plugin-react": "6.3.0",
    "@vitejs/plugin-rsc": "0.5.39",
    "@cloudflare/vite-plugin": "1.70.1",
    "wrangler": "4.168.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.8"
    }
  },
  "type": "module"
}
