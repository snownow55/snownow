{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "snowviking-cf-dev",
  "compatibility_date": "2026-11-24",
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "html_handling": "none",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/_next/static/*",
      "!/*/_next/static/*"
    ]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "vars": {
    "SNOW_DEPLOYMENT_ENV": "development",
    "NEXT_PUBLIC_SUPABASE_URL": "https://viidjrhaoxcvunbfdbni.supabase.co",
    "NEXT_PUBLIC_SITE_URL": "http://localhost:8787"
  },
  "observability": {
    "enabled": true
  }
}
