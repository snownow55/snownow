{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "types": [
      "vite/client",
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "../*"
      ],
      "next/link": [
        "src/next/link.tsx"
      ],
      "next/image": [
        "src/next/image.tsx"
      ],
      "next/navigation": [
        "src/next/navigation.ts"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts",
    "capacitor.config.ts"
  ]
}
